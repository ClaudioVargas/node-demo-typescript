# ============================================================
# Configuración de entorno - copia este archivo a `.env`
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)
# ============================================================

# --- Servidor ---
PORT=8000
# development | production | test
NODE_ENV=development

# --- Seguridad ---
# Clave para firmar/verificar los JWT (¡usa un valor aleatorio largo en prod!)
JWT_SECRET=secretKey
# Secreto de la sesión de express-session (OAuth de Google)
SESSION_SECRET=cats

# --- Google OAuth (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Base de datos (MySQL) ---
# NOTA DOCKER COMPOSE: dentro de la red de `docker compose` el host de la BD es
# el nombre del servicio (`db`), no `localhost`. Compose lo sobrescribe con
# `DB_HOST=${DB_HOST:-db}`. Fuera de Docker usa `localhost`.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=prueba_db
DB_USER=root
DB_PASSWORD=1234

# --- Pool de conexiones Sequelize (por worker) ---
# Total de conexiones aprox. en la BD = workers * DB_POOL_MAX
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000
DB_POOL_EVICT_MS=60000
DB_LOGGING=false

# --- Concurrencia (cluster) ---
# Número de workers del cluster. Vacío/0 => 1 worker en dev y nº de CPUs en prod.
WEB_CONCURRENCY=
# Tiempo máximo (ms) de espera del apagado elegante antes de forzar la salida.
SHUTDOWN_TIMEOUT_MS=30000